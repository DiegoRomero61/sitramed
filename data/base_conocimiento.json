  "enfermedades": [
    {
      "id": "ENF-01",
      "nombre": "Faringitis Aguda / Amigdalitis",
      "sintomas_clave": ["SINT-01", "SINT-02", "SINT-03"],
      "nivel_riesgo": "Bajo",
      "recomendaciones": "Guardar reposo vocal, mantener abundante hidratación con líquidos tibios y utilizar analgésicos de libre venta.",
      "canalizacion": "Médico General"
    },
    {
      "id": "ENF-02",
      "nombre": "Caries Avanzada / Infección Odontológica",
      "sintomas_clave": ["SINT-09", "SINT-25"],
      "nivel_riesgo": "Medio",
      "recomendaciones": "Evitar alimentos extremadamente fríos, calientes o azucarados. Realizar enjuagues con agua tibia salada. No automedicarse antibióticos.",
      "canalizacion": "Odontología / Cirujano Dentista"
    },
    {
      "id": "ENF-03",
      "nombre": "Conjuntivitis / Irritación Ocular",
      "sintomas_clave": ["SINT-10", "SINT-11"],
      "nivel_riesgo": "Bajo",
      "recomendaciones": "Lavar los ojos con solución fisiológica estéril, evitar frotarse los ojos y desinfectar manos antes de tocar la cara.",
      "canalizacion": "Oftalmología / Médico General"
    },
    {
      "id": "ENF-04",
      "nombre": "Patología Ocular Compleja (Glaucoma / Catarata / Desprendimiento)",
      "sintomas_clave": ["SINT-17", "SINT-18", "SINT-10"],
      "nivel_riesgo": "Medio / Alto",
      "recomendaciones": "Evitar esfuerzos visuales o físicos bruscos. No aplicar gotas médicas no recetadas.",
      "canalizacion": "Oftalmología Prioritaria"
    },
    {
      "id": "ENF-05",
      "nombre": "Traumatismo Articular o Osteomuscular (Esguince / Lesión)",
      "sintomas_clave": ["SINT-12", "SINT-13", "SINT-14", "SINT-20"],
      "nivel_riesgo": "Medio",
      "recomendaciones": "Aplicar hielo local envuelto en un paño durante 15 minutos, guardar reposo de la extremidad y evitar apoyar el peso corporal.",
      "canalizacion": "Traumatología y Ortopedia"
    },
    {
      "id": "ENF-06",
      "nombre": "Afección Hepática o Biliar (Ictericia / Anemia)",
      "sintomas_clave": ["SINT-21", "SINT-26"],
      "nivel_riesgo": "Alto",
      "recomendaciones": "Evitar el consumo de alcohol, alimentos grasos y medicamentos hepatotóxicos como paracetamol en dosis altas.",
      "canalizacion": "Gastroenterología / Medicina Interna"
    },
    {
      "id": "ENF-07",
      "nombre": "Dermatitis / Urticaria Cutánea",
      "sintomas_clave": ["SINT-19", "SINT-23"],
      "nivel_riesgo": "Bajo",
      "recomendaciones": "Evitar rascar la zona. Aplicar compresas frías y evitar jabones agresivos o perfumes.",
      "canalizacion": "Dermatología"
    },
    {
      "id": "ENF-08",
      "nombre": "Gastroenteritis / Síndrome Diarreico",
      "sintomas_clave": ["SINT-27", "SINT-02"],
      "nivel_riesgo": "Medio",
      "recomendaciones": "Iniciar hidratación oral con vida suero oral. Llevar dieta blanda (arroz, manzana, tostadas) y evitar lácteos o irritantes.",
      "canalizacion": "Gastroenterología / Médico General"
    },
    {
      "id": "ENF-09",
      "nombre": "Picadura / Picadura de Animal Ponzoñoso",
      "sintomas_clave": ["SINT-16"],
      "nivel_riesgo": "Urgente / Variable según especie",
      "recomendaciones": "Lave la zona con agua y jabón. No aplique torniquetes, hielo directo ni succione el veneno. Si presenta mareo, dificultad respiratoria o la especie es de alta peligrosidad (araña violín/viuda negra o alacrán), acuda de inmediato a urgencias.",
      "canalizacion": "Urgencias Médicas / Toxicología"
    },
    {
      "id": "ENF-10",
      "nombre": "Lesión Térmica / Quemadura",
      "sintomas_clave": ["SINT-28"],
      "nivel_riesgo": "Variable según profundidad y extensión",
      "recomendaciones": "Enfríe la zona con agua al tiempo (NO helada) por 10 a 15 minutos. No aplique remedios caseros (pasta de dientes, aceite, crema). No reviente ampollas. Si afecta cara, manos o articulaciones, busque valoración médica.",
      "canalizacion": "Urgencias / Cirugía Plástica y Quemados"
    },
    {
      "id": "ENF-11",
      "nombre": "Cuadro de Ansiedad / Crisis de Estrés",
      "sintomas_clave": ["SINT-29"],
      "nivel_riesgo": "Moderado / Emocional",
      "recomendaciones": "Realice la técnica de respiración diafragmática (Inhale en 4 seg, sostenga 4 seg, exhale en 6 seg). Busque un lugar tranquilo y recuerde que la crisis es temporal. Si la intensidad es alta o recurrente, solicite acompañamiento profesional.",
      "canalizacion": "Psicología / Psiquiatría / Psicoterapia"
    },
    {
      "id": "ENF-12",
      "nombre": "Disfunción Sexual / Incontinencia Urinaria",
      "sintomas_clave": ["SINT-22", "SINT-24"],
      "nivel_riesgo": "Bajo / Controlable",
      "recomendaciones": "Mantener hábitos de vida saludables, evitar el tabaco, reducir el estrés y realizar ejercicios de suelo pélvico (Kegel). Consulte a un especialista para una evaluación hormonal y funcional.",
      "canalizacion": "Urología / Sexología"
    }
  ]
}